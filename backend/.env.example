# Database URLs (PyMySQL driver)
DATABASE_URL=mysql+pymysql://skillswap:skillswap_pass@127.0.0.1:3307/skillswap?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://skillswap:skillswap_pass@127.0.0.1:3307/skillswap_test?charset=utf8mb4

# Security / JWT
JWT_SECRET_KEY=change-this-super-secret-jwt-key-for-skillswap-jklu-2026-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Email / SMTP Settings (Optional in dev, console fallback with DEV-ONLY flag)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@jklu.edu.in

# Application Environment
APP_ENV=development

# Business Logic Configuration
REPUTATION_PER_SESSION=10
REQUIRE_ADMIN_APPROVAL=false
